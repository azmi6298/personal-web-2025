---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/posts';

interface Props {
	post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
---

<div class="mb-10">
	<a
		href={`/blogs/${post.id}`}
		class="text-xl lg:text-2xl font-semibold hover:text-brand"
	>
		{post.data.title}
	</a>
	<p class="text-sm lg:text-xl grayed-text">
		{formatDate(post.data.pubDate)}
	</p>
</div>
