---
import { Icon } from 'astro-icon/components';
import GetResumeButton from '@/components/buttons/GetResumeButton.astro';
import { workExpYears } from '@/utils/constants';
import TechStackSlider from './TechStackSlider.astro';
import WorkHistory from '@/components/work-history/WorkHistory.astro';

export interface TechStack {
	label: string;
	icon: string;
}

const techStacks: TechStack[] = [
	{
		label: 'React',
		icon: 'react',
	},
	{
		label: 'Next.js',
		icon: 'nextjs',
	},
	{
		label: 'Typescript',
		icon: 'typescript',
	},
	{
		label: 'TailwindCSS',
		icon: 'tailwind',
	},
	{
		label: 'Storybook',
		icon: 'storybook',
	},
	{
		label: 'Astro',
		icon: 'astro',
	},
	{
		label: 'Jenkins',
		icon: 'jenkins',
	},
	{
		label: 'Ruby on Rails',
		icon: 'rails',
	},
	{
		label: 'Vue',
		icon: 'vue',
	},
	{
		label: 'Postgres',
		icon: 'postgres',
	},
];
---

<section
	id="about"
	class="px-8 lg:px-16 py-16 bg-surface dark:bg-surface-dark -mx-8 lg:-mx-24 rounded-2xl"
>
	<h2 class="section-title">About me</h2>
	<div class="grid gap-16 lg:grid-cols-2">
		<div class="about-container">
			<p class="grayed-text text-lg lg:text-xl">
				For the past {workExpYears} years, I've been building software for the web.
				When I step away from the keyboard, I'm probably out for a run. Feel free
				to kudos me on {' '}
				<a
					href="https://www.strava.com/athletes/105639249"
					target="_blank"
					rel="noreferrer"
					class="text-route underline underline-offset-2"
				>
					Strava
				</a>
			</p>

			<div class="social-row">
				<a
					href="https://www.linkedin.com/in/azmi6298/"
					target="_blank"
					rel="noreferrer"
				>
					<Icon name="linkedin" />
				</a>
				<a href="https://github.com/azmi6298" target="_blank" rel="noreferrer">
					<Icon name="github" />
				</a>
				<a
					href="https://instagram.com/azmi6298"
					target="_blank"
					rel="noreferrer"
				>
					<Icon name="instagram" />
				</a>
				<a
					href="https://www.threads.com/@azmi6298"
					target="_blank"
					rel="noreferrer"
				>
					<Icon name="threads" />
				</a>
			</div>

			<GetResumeButton />
		</div>

		<div class="work-history-col">
			<WorkHistory highlightOnly showTitle={false} />
			<a href="/about-me" class="more-link">More about me &rarr;</a>
		</div>
	</div>

	<div class="tech-band">
		<span class="font-semibold">Tech Stack Experience</span>
		<TechStackSlider data={techStacks} />
	</div>

	<style>
		.about-container {
			@apply h-full flex flex-col gap-y-8;
		}

		.social-row {
			@apply flex gap-5 text-2xl;
		}

		.social-row a:hover {
			@apply text-route;
		}

		.tech-band {
			@apply mt-16 pt-8 border-t border-line dark:border-line-dark flex flex-col gap-y-6;
		}

		.work-history-col {
			@apply flex flex-col justify-between gap-y-8;
		}

		.more-link {
			@apply self-end font-bold text-route underline underline-offset-4 hover:text-ink dark:hover:text-ink-dark transition-colors duration-200;
		}
	</style>
</section>
