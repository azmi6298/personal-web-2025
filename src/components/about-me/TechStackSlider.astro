---
import { Icon } from 'astro-icon/components';
import type { TechStack } from './AboutMe.astro';

interface Props {
	data: TechStack[];
}

const { data } = Astro.props;
---

<div class="marquee">
	<div class="marquee-track">
		{
			[...data, ...data].map((item) => (
				<div class="card">
					<Icon name={item.icon} class="w-16 h-16 icon" />
					<span class="text-sm font-semibold">{item.label}</span>
				</div>
			))
		}
	</div>
</div>

<style>
	.marquee {
		@apply max-w-full overflow-hidden;
		mask-image: linear-gradient(
			90deg,
			transparent 0,
			black 8%,
			black 92%,
			transparent 100%
		);
	}

	.marquee-track {
		@apply flex w-max gap-20;
		animation: scroll-left 34s linear infinite;
	}

	.card {
		@apply flex flex-shrink-0 flex-col items-center justify-center gap-2;
	}

	.card .icon {
		@apply grayscale opacity-60 transition duration-200;
	}

	.card:hover .icon {
		@apply grayscale-0 opacity-100;
	}

	@keyframes scroll-left {
		from {
			transform: translateX(0);
		}
		to {
			transform: translateX(-50%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
		.marquee {
			overflow-x: auto;
			mask-image: none;
		}
	}
</style>
