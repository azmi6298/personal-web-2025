---
import { latestResumeLink } from '@/utils/constants';
import { Icon } from 'astro-icon/components';
---

<a
	href={latestResumeLink}
	target="_blank"
	rel="noopener noreferrer"
	class="inline-flex items-center gap-2 text-sm lg:text-base font-bold bg-route text-route-ink border-2 border-route px-5 py-3 lg:px-6 rounded-full w-fit transition duration-200 hover:-translate-y-0.5 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
	<Icon name="document" class="inline-block lg:h-6 lg:w-6 text-route-ink" />
	Get Latest Resume
</a>
