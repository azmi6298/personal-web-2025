---
import { Icon } from 'astro-icon/components';

interface Menu {
	label: string;
	path: string;
}

const menus: Menu[] = [
	{
		label: 'Home',
		path: '/',
	},
	{
		label: 'About',
		path: '/about-me',
	},
	{
		label: 'Blogs',
		path: '/blogs',
	},
];

const currentPath = Astro.url.pathname;
const isActive = (path: string) =>
	path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<header class="fixed z-50 top-6 translate-x-[-50%] left-[50%]">
	<div class="header-container">
		<div class="flex divide-x-2 divide-brand justify-between items-center">
			{
				menus.map((menu) => (
					<a
						href={menu.path}
						class="menu"
						aria-current={isActive(menu.path) ? 'page' : undefined}
					>
						{menu.label}
					</a>
				))
			}
			<button
				id="theme-toggle"
				type="button"
				aria-label="Toggle dark mode"
				aria-pressed="false"
				class="theme-toggle"
			>
				<Icon name="sun" class="theme-icon theme-icon--sun" />
				<Icon name="moon" class="theme-icon theme-icon--moon" />
			</button>
		</div>
	</div>
</header>

<script>
	function initThemeToggle() {
		const button = document.getElementById('theme-toggle');
		if (!button || button.dataset.bound) return;
		button.dataset.bound = 'true';

		button.setAttribute(
			'aria-pressed',
			String(document.documentElement.classList.contains('dark')),
		);

		button.addEventListener('click', () => {
			const isDark = document.documentElement.classList.toggle('dark');
			localStorage.setItem('theme', isDark ? 'dark' : 'light');
			button.setAttribute('aria-pressed', String(isDark));
		});
	}

	initThemeToggle();
	document.addEventListener('astro:after-swap', initThemeToggle);
</script>

<style>
	.header-container {
		@apply border border-line dark:border-line-dark bg-surface dark:bg-surface-dark mx-auto lg:max-w-screen-xl py-3 px-4 lg:px-7 rounded-full;
	}

	.menu {
		@apply relative px-4 lg:px-6 py-2 text-sm lg:text-lg font-semibold text-ink-muted dark:text-ink-muted-dark;
		@apply inline-block transition-colors duration-200 hover:text-ink dark:hover:text-ink-dark;
	}

	.menu::after {
		content: '';
		@apply absolute left-4 right-4 lg:left-6 lg:right-6 bottom-1 h-0.5 bg-route origin-left scale-x-0 transition-transform duration-200;
	}

	.menu:hover::after,
	.menu[aria-current='page']::after {
		@apply scale-x-100;
	}

	.menu[aria-current='page'] {
		@apply text-ink dark:text-ink-dark;
	}

	.theme-toggle {
		@apply pl-4 lg:pl-6 text-base lg:text-xl hover:*:text-route;
	}

	.theme-icon {
		@apply hidden transition-transform duration-300;
	}

	.theme-toggle:hover .theme-icon {
		transform: rotate(25deg);
	}

	:global(html:not(.dark)) .theme-icon--sun {
		@apply inline-block;
	}

	:global(html.dark) .theme-icon--moon {
		@apply inline-block;
	}

	@media (prefers-reduced-motion: reduce) {
		.menu,
		.menu::after,
		.theme-icon {
			@apply transition-none;
		}

		.theme-toggle:hover .theme-icon {
			transform: none;
		}
	}
</style>
