---
import { positions } from '@/utils/constants';

interface Props {
	highlightOnly?: boolean;
	showTitle?: boolean;
}

const { highlightOnly, showTitle = true } = Astro.props;

const filtered = highlightOnly
	? positions.filter((position) => position.isHighlight)
	: positions;
const shown = [...filtered].sort((a, b) =>
	(b.endDate ?? '9999').localeCompare(a.endDate ?? '9999'),
);

function formatDate(yearMonth: string) {
	const [year, month] = yearMonth.split('-').map(Number);
	return new Date(year, month - 1).toLocaleDateString('en-US', {
		month: 'long',
		year: 'numeric',
	});
}

function formatRange(startDate: string, endDate: string | null) {
	return `${formatDate(startDate)} - ${endDate ? formatDate(endDate) : 'Present'}`;
}
---

<div class="work-history-container">
	{showTitle && <h2 class="section-title">Work History</h2>}
	<ol class="splits">
		<div class="route-path" aria-hidden="true">
			<svg viewBox="0 0 2 100" preserveAspectRatio="none">
				<path d="M1,0 L1,100" pathLength="1"></path>
			</svg>
		</div>
		{
			shown.map((position, index) => (
				<li class="split-item">
					<span
						class={`split-dot ${index === 0 && !position.endDate ? 'is-current' : ''}`}
					/>
					<p class="split-range grayed-text">
						{formatRange(position.startDate, position.endDate)}
					</p>
					<p class="split-title">
						{position.link ? (
							<a href={position.link} target="_blank" rel="noreferrer">
								{position.title}
							</a>
						) : (
							position.title
						)}
					</p>
					<p class="grayed-text">{position.description}</p>
				</li>
			))
		}
	</ol>
</div>

<style>
	.work-history-container {
		@apply flex flex-col gap-y-6;
	}

	.splits {
		@apply relative;
	}

	.route-path {
		@apply absolute left-[5px] top-[0.6rem] bottom-[0.6rem] w-0.5;
	}

	.route-path svg {
		@apply h-full w-0.5 block;
	}

	.route-path path {
		fill: none;
		stroke: theme('colors.route');
		stroke-width: 2;
		stroke-dasharray: 1;
		stroke-dashoffset: 0;
	}

	@supports (animation-timeline: view()) {
		.route-path path {
			stroke-dashoffset: 1;
			animation: draw-route linear forwards;
			animation-timeline: view(block 90% 10%);
		}
	}

	@keyframes draw-route {
		from {
			stroke-dashoffset: 1;
		}
		to {
			stroke-dashoffset: 0;
		}
	}

	.split-item {
		@apply relative pl-8 pb-9;
	}

	.split-item:last-child {
		@apply pb-0;
	}

	.split-dot {
		@apply absolute left-0 top-[0.4rem] w-3 h-3 rounded-full bg-paper dark:bg-paper-dark border-2 border-route;
	}

	.split-dot.is-current::after {
		content: '';
		@apply absolute -inset-[5px] rounded-full border border-route animate-[pulse-ring_2s_ease-out_infinite];
	}

	.split-range {
		@apply text-sm lg:text-base;
	}

	.split-title {
		@apply font-bold text-xl lg:text-2xl mt-1;
	}

	.split-title a {
		@apply underline underline-offset-2 hover:text-route transition-colors duration-200;
	}

	@keyframes pulse-ring {
		0% {
			transform: scale(0.6);
			opacity: 0.8;
		}
		100% {
			transform: scale(1.6);
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.split-dot.is-current::after {
			animation: none;
			display: none;
		}

		.route-path path {
			animation: none;
			stroke-dashoffset: 0;
		}
	}
</style>
