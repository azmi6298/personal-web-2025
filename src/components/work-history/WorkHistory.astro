---
import { positions } from '@/utils/constants';

interface Props {
	limit?: number;
}

const { limit } = Astro.props;

const sorted = [...positions].sort((a, b) =>
	(b.endDate ?? '9999').localeCompare(a.endDate ?? '9999'),
);
const shown = limit ? sorted.slice(0, limit) : sorted;

function formatDate(yearMonth: string) {
	const [year, month] = yearMonth.split('-').map(Number);
	return new Date(year, month - 1).toLocaleDateString('en-US', {
		month: 'long',
		year: 'numeric',
	});
}

function formatRange(startDate: string, endDate: string | null) {
	return `${formatDate(startDate)} - ${endDate ? formatDate(endDate) : 'Present'}`;
}
---

<div class="work-history-container">
	<h2 class="section-title">Work History</h2>
	<ol class="flex flex-col gap-y-6">
		{
			shown.map((position) => (
				<li class="relative border-l border-gray-300 dark:border-gray-700 pl-6">
					<span class="dot" />
					<p class="font-semibold text-base lg:text-lg grayed-text">
						{formatRange(position.startDate, position.endDate)}
					</p>
					<p class="font-bold text-xl lg:text-3xl">
						{position.link ? (
							<a
								href={position.link}
								target="_blank"
								rel="noreferrer"
								class="hover:text-brand underline underline-offset-2"
							>
								{position.title}
							</a>
						) : (
							position.title
						)}
					</p>
					<p class="grayed-text">{position.description}</p>
				</li>
			))
		}
	</ol>
</div>

<style>
	.work-history-container {
		@apply h-full flex flex-col justify-center gap-y-6;
	}

	.dot {
		@apply absolute -left-[5px] top-1.5 w-2 h-2 rounded-full bg-brand;
	}
</style>
