---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import GetResumeButton from '@/components/buttons/GetResumeButton.astro';
import WorkHistory from '@/components/work-history/WorkHistory.astro';
import portraitImage from '@/images/azmi-portrait.jpeg';
import Layout from '@/layouts/Layout.astro';
import { workExpYears } from '@/utils/constants';
---

<Layout>
	<div class="base-container snap-container">
		<section
			class="snap-section py-36 lg:py-0 relative flex flex-col lg:flex-row justify-center items-center gap-16"
		>
			<div class="w-full flex flex-col gap-y-8 items-center">
				<Image
					class="w-28 h-28 md:w-48 md:h-48 rounded-full"
					src={portraitImage}
					alt="Azmi"
				/>
				<div class="flex gap-x-5 text-4xl">
					<a
						href="https://www.linkedin.com/in/azmi6298/"
						target="_blank"
						rel="noreferrer"
					>
						<Icon name="linkedin" class="hover:text-blue-400" />
					</a>
					<a
						href="https://github.com/azmi6298"
						target="_blank"
						rel="noreferrer"
					>
						<Icon name="github" class="hover:text-gray-600" />
					</a>
					<a
						href="https://instagram.com/azmi6298"
						target="_blank"
						rel="noreferrer"
					>
						<Icon name="instagram" class="hover:text-orange-400" />
					</a>
				</div>
				<GetResumeButton />
			</div>
			<div class="flex flex-col gap-y-4">
				<p class="font-semibold text-2xl lg:text-6xl">Hi, I'm Azmi</p>
				<p class="description">
					I'm a Software Engineer with {workExpYears} years of experience, mostly
					building on the frontend. While frontend is my main thing, I've also spent
					time across the full stack, so I'm comfortable jumping into different parts
					of the product when needed.
				</p>
				<p class="description">
					Outside of work, you'll probably find me on{' '}
					<a
						href="https://www.strava.com/athletes/105639249"
						target="_blank"
						class="text-orange-500"
					>
						Strava
					</a>. Feel free to drop a kudos if you stumble across one of my runs🧡
				</p>
			</div>
			<a
				href="#work-history"
				aria-label="Scroll to work history"
				class="flex absolute bottom-8 left-1/2 -translate-x-1/2 items-center justify-center w-12 h-12 rounded-full bg-brand/20 text-brand animate-bounce transition duration-200 hover:bg-brand hover:text-gray-100 hover:scale-110 hover:shadow-lg hover:shadow-brand/40 motion-reduce:animate-none"
			>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					class="w-6 h-6"
				>
					<path d="m6 9 6 6 6-6"></path>
				</svg>
			</a>
		</section>
		<section
			id="work-history"
			class="snap-section min-h-dvh h-auto max-w-screen-sm py-24 mx-auto scroll-mt-8"
		>
			<WorkHistory />
		</section>
	</div>
</Layout>

<style>
	.description {
		@apply text-lg md:text-xl font-light;
	}
</style>
