---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import GetResumeButton from '@/components/buttons/GetResumeButton.astro';
import portraitImage from '@/images/azmi-portrait.jpeg';
import Layout from '@/layouts/Layout.astro';
import { workExpYears } from '@/utils/constants';
---

<Layout>
	<div class="base-container">
		<div
			class="flex flex-col lg:flex-row lg:h-dvh justify-center items-center gap-16"
		>
			<div class="w-full flex flex-col gap-y-8 items-center">
				<Image
					class="w-28 h-28 md:w-48 md:h-48 rounded-full"
					src={portraitImage}
					alt="Azmi"
				/>
				<div class="flex gap-x-5 text-4xl">
					<a
						href="https://www.linkedin.com/in/azmi6298/"
						target="_blank"
						rel="noreferrer"
					>
						<Icon name="linkedin" class="hover:text-blue-400" />
					</a>
					<a
						href="https://github.com/azmi6298"
						target="_blank"
						rel="noreferrer"
					>
						<Icon name="github" class="hover:text-gray-600" />
					</a>
					<a
						href="https://instagram.com/azmi6298"
						target="_blank"
						rel="noreferrer"
					>
						<Icon name="instagram" class="hover:text-orange-400" />
					</a>
				</div>
				<GetResumeButton />
			</div>
			<div class="flex flex-col gap-y-4">
				<p class="font-semibold text-xl md:text-2xl lg:text-4xl">
					Hi, I'm Azmi
				</p>
				<p class="description">
					I'm a Software Engineer with over 7 years of experience, starting my
					career in 2019. My primary focus is frontend development, where I
					enjoy building fast, scalable, and user-friendly web applications.
					Along the way, I've also gained hands-on experience across the full
					stack, allowing me to collaborate effectively on end-to-end product
					development.
				</p>
				<p class="description">
					Outside of work, you'll usually find me out for a run. It's become my
					favorite way to reset, challenge myself, and stay consistent. I enjoy
					the process as much as the progress, and the mindset I've built
					through running naturally carries over into how I approach software
					engineering.
				</p>
			</div>
		</div>
	</div>
</Layout>

<style>
	.description {
		@apply text-sm md:text-lg;
	}
</style>
