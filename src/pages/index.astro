---
import AboutMe from '../components/about-me/AboutMe.astro';
import Blogs from '../components/blogs/Blogs.astro';
import Hero from '../components/hero/Hero.astro';
import Layout from '../layouts/Layout.astro';
import '../styles/globals.css';
import GetResumeButton from '@/components/buttons/GetResumeButton.astro';
import WorkHistory from '@/components/work-history/WorkHistory.astro';
---

<Layout>
	<div class="base-container snap-container">
		<section class="snap-section">
			<Hero />
		</section>
		<section class="snap-section">
			<div class="h-full lg:grid lg:grid-cols-2 gap-16">
				<AboutMe />
				<div class="hidden h-full lg:flex flex-col justify-center gap-y-6">
					<WorkHistory highlightOnly />
					<a
						href="/about-me"
						class="self-center text-sm lg:text-xl font-semibold"
					>
						See More..
					</a>
					<GetResumeButton />
				</div>
			</div>
		</section>
		<section
			class="snap-section lg:hidden h-full flex flex-col justify-center gap-y-6"
		>
			<WorkHistory highlightOnly />
			<a href="/about-me" class="self-center text-sm lg:text-xl font-semibold">
				See More..
			</a>
			<GetResumeButton />
		</section>
		<section class="snap-section">
			<Blogs />
		</section>
	</div>
</Layout>
